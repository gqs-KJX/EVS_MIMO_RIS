\newlabel{fig:s_generalization}{{5}{9}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Serialized single-thread cost. (a)~Component-median decomposition. (b)~p95 position-error--cost plane at $-10$~dB; marker area is proportional to peak resident memory and each point is labeled by its measured peak RSS.}}{9}{}\protected@file@percent }
