\@writefile{lot}{\contentsline {table}{\numberline {VIII}{\ignorespaces External benchmark below the operating region, $960$ shared-realization trials per cell, method-consistent tier. $P_{\rm  cat}$ in percent, position quantiles in millimeters. The proposed route holds the lowest median and p95 at both points; the initializer-free grid search of the OMP route holds the lowest catastrophic rate at $-20$~dB and ties the proposed route at $-15$~dB, which is the crossover discussed in the text.}}{11}{}\protected@file@percent }
\newlabel{tab:s_benchmark}{{VIII}{11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces External benchmark over the full campaign range, $960$ shared-realization trials per SNR point. Panels extend Fig.~\ref {main-fig:benchmark_combined} of the main paper. In~(c), at the two points below the operating region the exhaustive near-field OMP search fails less often than the locally refined proposed route, at the cost of the grid-resolution floor visible in~(a) at every SNR.}}{12}{}\protected@file@percent }
