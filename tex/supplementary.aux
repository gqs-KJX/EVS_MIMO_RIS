\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Nested component ladder at $-10$~dB (solid, operating region) and $-20$~dB (dashed, below it). (a)~Catastrophic rate with exact $95\%$ intervals; annotations between rungs are absolute percentage-point changes at $-20$~dB. (b)~Phase~I basin acquisition rate. (c)~Empirical position-error CDF for the four informative rungs; the $-20$~dB R3 plateau is the wrong-basin mass removed by the common-geometry initializer.}}{3}{}\protected@file@percent }
\newlabel{fig:s_ablation}{{1}{3}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Resolvability test summary at $-10$~dB, $480$ paired trials per cell. ``Spread'' is the largest difference in resolution probability across the four Jones overlaps at fixed delay separation, and the trend-test column reports the Holm-adjusted Cochran--Armitage $p$ value over overlap.}}{3}{}\protected@file@percent }
\newlabel{tab:s_resolv}{{IV}{3}{}{}{}}
