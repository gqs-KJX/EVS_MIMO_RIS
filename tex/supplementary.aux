\newlabel{fig:s_receiver}{{4}{3}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces External benchmark over the full campaign range, $480$ shared-realization trials per SNR point. Panels as in Fig.~7 of the main paper. In~(c), below $-20$~dB the exhaustive near-field OMP search is more robust than the locally refined proposed route, at the cost of the grid-resolution floor visible in~(b) at every SNR.}}{4}{}\protected@file@percent }
\newlabel{fig:s_benchmark}{{5}{4}{}{}{}}
