\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces External benchmark, $960$ shared-realization trials per cell. Runtime and peak RSS use the serialized single-thread protocol. NMSE is the unconditional mean over all trials, so a single wrong-basin trial dominates it: the range-scaled 4-D entry at $0$~dB is $5.6\times 10^{-6}$ over its $959$ inliers and $1.0\times 10^{-3}$ once its one catastrophic trial is included. The p99 column indicates tail mass but does not resolve it: for a route carrying about $1\%$ catastrophic mass that order statistic lands on the boundary between the two modes, giving bootstrap $95\%$ intervals at $-10$~dB of $[197,1365]$ and $[368,1347]$~mm for range-scaled 4-D VP and VBI/SBL against $[1.15,1.80]$~mm for the proposed route. The main paper's complementary CDFs carry the tail comparison.}}{8}{}\protected@file@percent }
\newlabel{tab:s_benchmark_main}{{VI}{8}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces Paired Stage-I sensitivity at $-10$~dB, $480$ trials per value. Boldface marks the frozen setting. ``Identical'' counts trials whose position estimate is unchanged from the frozen setting to working precision.}}{8}{}\protected@file@percent }
\newlabel{tab:hypersens}{{VII}{8}{}{}{}}
