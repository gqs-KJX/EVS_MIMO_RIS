\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces C2 single-factor compression test: (a)~delay-error median (solid, filled markers) and p95 (dashed, hollow markers), (b)~catastrophic rate with exact $95\%$ Clopper--Pearson intervals, and (c)~subspace diagnostics. The two arms share every stage except the domain in which the delay subspace is estimated. At $-10$~dB their basin-acquisition rates are $99.38\%$ and $97.50\%$; the white-noise floor is $r/I=1/16$.}}{11}{}\protected@file@percent }
\newlabel{fig:compression}{{3}{11}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces C3 control at $-10$~dB, $100$ paired strong-initializer trials. RMSEs are conditional on the inliers of each row, so $P_{\rm  cat}$ is reported beside them; ``Eval.'' is the median outer evaluation count. Six decimal places are shown only to expose the unit dependence of the explicit 4-D route and are not a precision claim.}}{11}{}\protected@file@percent }
\newlabel{tab:c3_control}{{I}{11}{}{}{}}
