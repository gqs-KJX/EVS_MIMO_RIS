\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces C1 evidence under a common absolute noise level, $480$ paired trials per point or cell. (a)~Matched estimator accuracy (solid) against the free-Jones PEB (dashed) for the three receiver modes. (b)~Paired inlier-conditional efficiency ratio; the shaded band is the $\pm 2\%$ interval quoted in the abstract, and the scalar curve leaves the plotted range at the two values printed in the panel. (c)--(e)~Resolution probability versus delay separation and Jones overlap at $-10$~dB, with the dashed line marking the minimum cascaded-delay separation of the reference scene. Full EVS retains cross-panel polarimetric separability; reduced modes become overlap sensitive.}}{10}{}\protected@file@percent }
\newlabel{fig:c1_combined}{{2}{10}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-D}}C3: Clock-Unit Control}{10}{}\protected@file@percent }
