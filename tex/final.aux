\newlabel{fig:robustness}{{9}{22}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces RIS element-phase calibration boundary at $-10$~dB. The Stage-I output alone is not a usable estimate at any calibration level; the certified Phase-II refinement is what converts the initializer into a millimeter-accurate estimator.}}{22}{}\protected@file@percent }
\newlabel{fig:ris_calibration}{{10}{22}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Generalization and scaling at $-10$~dB. (a)~CDF of the per-position catastrophic rate over the $50$-position grid, $480$ trials per position. (b)~Per-position median $\lambda _{\min }$ and condition number of the free-Jones EFIM, sorted; the bound is never rank deficient. (c)~Catastrophic rate against the swept resource for the proposed route (bold) and R2 (faint).}}{23}{}\protected@file@percent }
\newlabel{fig:generalization}{{11}{23}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Delay--polarization resolution probability at $-10$~dB, $480$ trials per cell, against the target delay separation and the polarization overlap of the two paths (the modulus of their Jones inner product; a small overlap places the second path close to the components the reduced masks discard). The full six-component receiver is insensitive to the overlap at every separation, reaching $0.91$ at $0.62/B_{\rm  occ}$ and $0.37$--$0.40$ at $0.31/B_{\rm  occ}$, whereas the dual-polarized receiver loses the pair entirely at small overlap and the scalar receiver never resolves.}}{23}{}\protected@file@percent }
\newlabel{fig:resolvability}{{12}{23}{}{}{}}
