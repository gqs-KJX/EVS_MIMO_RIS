\midrule
Baseline (raw EVS) & $21.46\ [17.9,25.4]$ & $62.08$ & $1.618$\\
\;+ MKSC compression & $5.62\ [3.7,8.1]$ & $78.12$ & $0.277$\\
\;+ common geometry & $3.96\ [2.4,6.1]$ & $96.04$ & $3.09\!\times\!10^{-3}$\\
\;+ anchor refresh & $\mathbf{3.54}\ [2.1,5.6]$ & $\mathbf{96.25}$ &
$\mathbf{3.06\!\times\!10^{-3}}$\\
\;\;\emph{ctrl:} oracle start & $3.33\ [1.9,5.4]$ & $96.46$ &
$2.98\!\times\!10^{-3}$\\
